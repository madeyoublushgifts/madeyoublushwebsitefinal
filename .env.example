# Formspree — https://formspree.io
# Create one form per type; copy each form ID (the part after /f/ in the endpoint URL).

# Contact page — general messages
VITE_FORMSPREE_CONTACT_ID=your_contact_form_id

# Shop — inquire / pre-order
VITE_FORMSPREE_INQUIRY_ID=your_inquiry_form_id

# Build a Bouquet — custom stem builder (https://formspree.io/f/xzdwjevj)
VITE_FORMSPREE_BUILD_BOUQUET_ID=xzdwjevj

# Coming Soon — floral subscription waitlist
VITE_FORMSPREE_WAITLIST_ID=your_waitlist_form_id
