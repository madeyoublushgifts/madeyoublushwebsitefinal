# Public site URL (for SEO, sitemap, Open Graph, Stripe redirects)
VITE_SITE_URL=https://www.madeyoublush.ca

# Google Business Profile share / listing URL
VITE_GOOGLE_BUSINESS_URL=https://share.google/Xt7UfFkDRsu6SqYYO

# Stripe — https://dashboard.stripe.com
# Publishable key (safe for browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Subscription display amounts (CAD cents) — server uses STRIPE_* without VITE_ prefix
VITE_STRIPE_BIWEEKLY_AMOUNT_CENTS=3499
VITE_STRIPE_MONTHLY_AMOUNT_CENTS=3499

# Server-only (set in Vercel → Settings → Environment Variables, NOT in client)
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_BIWEEKLY_AMOUNT_CENTS=3499
# STRIPE_MONTHLY_AMOUNT_CENTS=3499
# SITE_URL=https://www.madeyoublush.ca

# Resend — order + early-access confirmation emails (server-only)
# https://resend.com/api-keys — verify madeyoublush.ca domain before sending from info@
# RESEND_API_KEY=re_your_api_key
# ORDER_FROM_EMAIL=info@madeyoublush.ca
# ORDER_NOTIFY_EMAIL=info@madeyoublush.ca

# Formbricks — Client Response API (no API key). Defaults match Made You Blush production.
# Override only if you recreate surveys in another environment.
VITE_FORMBRICKS_APP_URL=https://app.formbricks.com
VITE_FORMBRICKS_ENVIRONMENT_ID=cmsjm2ef862ue01s22sgiuks0
# Early-access giveaway
VITE_FORMBRICKS_SURVEY_ID=cmsjmvqza621y01s5p3ardf5j
# Optional overrides (app has built-in defaults if blank)
# VITE_FORMBRICKS_CONTACT_SURVEY_ID=cmsk0dyon6vji01qdl1c6on71
# VITE_FORMBRICKS_INQUIRY_SURVEY_ID=cmsk1ctph6vnw01u2z2dav1ho
# VITE_FORMBRICKS_WAITLIST_SURVEY_ID=cmsk1cuur6sbb01sgkc7d7n54
