# Public site URL (for SEO, sitemap, Open Graph, Stripe redirects)
VITE_SITE_URL=https://www.madeyoublush.ca

# Google Business Profile share / listing URL
VITE_GOOGLE_BUSINESS_URL=https://share.google/Xt7UfFkDRsu6SqYYO

# Stripe — https://dashboard.stripe.com
# Publishable key (safe for browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Subscription display amounts (CAD cents) — server uses STRIPE_* without VITE_ prefix
VITE_STRIPE_BIWEEKLY_AMOUNT_CENTS=3499
VITE_STRIPE_MONTHLY_AMOUNT_CENTS=3499

# Server-only (set in Vercel → Settings → Environment Variables, NOT in client)
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_BIWEEKLY_AMOUNT_CENTS=3499
# STRIPE_MONTHLY_AMOUNT_CENTS=3499
# SITE_URL=https://www.madeyoublush.ca

# Formspree — https://formspree.io
# Create one form per type; copy each form ID (the part after /f/ in the endpoint URL).

# Contact page — general messages
VITE_FORMSPREE_CONTACT_ID=your_contact_form_id

# Shop — inquire / pre-order
VITE_FORMSPREE_INQUIRY_ID=your_inquiry_form_id

# Build a Bouquet — custom stem builder (https://formspree.io/f/xzdwjevj)
VITE_FORMSPREE_BUILD_BOUQUET_ID=xzdwjevj

# Coming Soon — floral subscription waitlist (legacy fallback)
VITE_FORMSPREE_WAITLIST_ID=your_waitlist_form_id
